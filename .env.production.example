# Modèle de configuration de production : copier en .env sur le serveur,
# remplir les valeurs entre chevrons, puis lancer php artisan key:generate.
# Voir docs/exploitation.md.

APP_NAME="Gestion OM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<nom-du-serveur>
APP_TIMEZONE=Indian/Antananarivo
APP_FORCE_HTTPS=true

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# Adresse du proxy qui termine le https, s'il n'est pas sur cette machine (sinon 127.0.0.1).
TRUSTED_PROXIES=127.0.0.1

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gestion_om
DB_USERNAME=gestion_om
DB_PASSWORD=<mot-de-passe-de-la-base>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Nom du serveur tel que les navigateurs l'appellent, sans https://
SANCTUM_STATEFUL_DOMAINS=<nom-du-serveur>

# Durée d'une mission : inclusive_days, nights ou started_days
OM_DURATION_CONVENTION=inclusive_days

# Sauvegardes quotidiennes (om:sauvegarde) et test de restauration (om:verifier-sauvegarde)
BACKUP_PATH=/var/backups/gestion-om
BACKUP_KEEP_DAYS=30
BACKUP_TIME=02:00
BACKUP_VERIFY_TIME=02:30
# Dossier de pg_dump et pg_restore s'ils ne sont pas dans le PATH (même version que le serveur, ou plus récente)
# BACKUP_PG_BIN=/usr/lib/postgresql/16/bin
